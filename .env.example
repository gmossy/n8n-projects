# ── WhatsApp via CallMeBot (free, no account needed) ────────────────────────
# Setup: save +34 644 24 46 05 on WhatsApp, send "I allow callmebot to send me messages"
# You'll receive your API key in reply (e.g. 1234567)
CALLMEBOT_PHONE=1XXXXXXXXXX        # your WhatsApp number, no + prefix
CALLMEBOT_APIKEY=your_api_key_here # key received from CallMeBot

# ── Frontend server ──────────────────────────────────────────────────────────
PORT=3200

# ── n8n → frontend URL ───────────────────────────────────────────────────────
# Docker:      http://frontend:3200   (set automatically by docker-compose)
# Bare-metal:  leave blank (defaults to http://localhost:3200)
# N8N_CONFIG_SERVER_URL=http://frontend:3200
